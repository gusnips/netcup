{
  "name": "netcup-sdk",
  "version": "1.0.0",
  "packageManager": "bun@1.4.4",
  "description": "Netcup CLI and typed JavaScript client for server and DNS management",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.mts",
        "default": "./dist/cli.mjs"
      },
      "require": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      }
    }
  },
  "bin": {
    "netcup": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "npx -y -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript openapi.json -o src/schema.d.ts && npx -y -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript openapi-ccp.json -o src/ccp-schema.d.ts && oxfmt src/schema.d.ts src/ccp-schema.d.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build"
  },
  "keywords": [
    "netcup",
    "scp",
    "ccp",
    "dns",
    "mcp",
    "server",
    "vps",
    "api-client",
    "typescript"
  ],
  "author": "Gustavo Salomé (gusnips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/netcup.git"
  },
  "bugs": {
    "url": "https://github.com/gusnips/netcup/issues"
  },
  "homepage": "https://github.com/gusnips/netcup#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "openapi-fetch": "^0.17.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}
